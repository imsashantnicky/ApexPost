@model ApexPost.Web.Models.ServiceForm
@{ ViewData["Title"] = "Edit service"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Edit @Model.Name</h1></div></div>
<div class="card form-card"><div class="card-body"><form asp-action="Edit" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><div class="row g-3"><div class="col-md-4"><label asp-for="Code" class="form-label">Service code</label><input asp-for="Code" class="form-control" readonly/></div><div class="col-md-8"><label asp-for="Name" class="form-label">Service name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save changes</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></div></div>
