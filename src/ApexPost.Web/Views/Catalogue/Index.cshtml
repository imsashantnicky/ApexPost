@model IReadOnlyList<ApexPost.Application.Catalogue.ServiceResponse>
@{ ViewData["Title"] = "Catalogue"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Service catalogue</h1><p class="text-secondary">Available services and pricing records feed counter and shipment workflows.</p></div><a class="btn btn-primary" asp-action="Create">Add service</a></div>
@if (Model.Count == 0) { <div class="empty-state"><h2 class="h5">No services configured</h2><p>Add services before counter staff can build service baskets or book shipments.</p><a class="btn btn-primary" asp-action="Create">Add service</a></div> }
else { <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Service</th><th>Description</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Code</td><td>@item.Name</td><td>@item.Description</td><td><span class="badge @(item.Availability == ApexPost.Domain.Catalogue.ServiceAvailability.Available ? "text-bg-success" : "text-bg-secondary")">@item.Availability</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> @if (item.Availability == ApexPost.Domain.Catalogue.ServiceAvailability.Available) { <form asp-action="Deactivate" method="post" class="d-inline" data-confirm="Make this service unavailable for new operations?"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><button class="btn btn-sm btn-outline-danger">Deactivate</button></form> }</td></tr> }</tbody></table></div></div> }
