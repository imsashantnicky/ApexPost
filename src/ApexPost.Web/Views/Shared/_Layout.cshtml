@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var canAdminister = authenticated && (await AuthorizationService.AuthorizeAsync(User, "AdministratorOnly")).Succeeded;
    var canUseInventory = authenticated && (await AuthorizationService.AuthorizeAsync(User, "InventoryOperations")).Succeeded;
    var canUseCounter = authenticated && (await AuthorizationService.AuthorizeAsync(User, "CounterOperations")).Succeeded;
    var canReadReports = authenticated && (await AuthorizationService.AuthorizeAsync(User, "ReportsAccess")).Succeeded;
}
<!DOCTYPE html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApexPost.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Main navigation">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">ApexPost <span class="brand-caption">Counter operations</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavigation" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (authenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            @if (canAdminister)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Branches" asp-action="Index">Branches</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="Index">Staff</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Catalogue" asp-action="Index">Catalogue</a></li>
                            }
                            @if (canUseInventory) { <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index">Inventory</a></li> }
                            @if (canUseCounter)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Transactions" asp-action="Index">Counter transactions</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Shipments" asp-action="Index">Shipments</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="MoneyOrders" asp-action="Create">Money orders &amp; ID verification</a></li>
                            }
                            @if (canReadReports) { <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li> }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        }
                    </ul>
                    @if (authenticated)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex"><button type="submit" class="btn btn-outline-light btn-sm">Sign out</button></form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div id="offline-status" class="offline-status" role="status" aria-live="polite"></div>
    <div class="container page-content">
        <main role="main" class="pb-3">
            @if (TempData["Status"] is string statusMessage) { <div class="alert alert-success" role="status">@statusMessage</div> }
            @if (TempData["Error"] is string errorMessage) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 ApexPost Logistics · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/apexpost-browser-storage.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
