@model IReadOnlyList<ApexPost.Application.Transactions.TransactionResponse>
@{ ViewData["Title"] = "Counter transactions"; }
<div class="page-heading"><div><p class="eyebrow">Counter</p><h1>Counter transactions</h1><p class="text-secondary">Open a basket, add catalogue services, then record its payment status.</p></div><a class="btn btn-primary" asp-action="Create">New transaction</a></div>
@if (TempData["Status"] is string status) { <div class="alert alert-success" role="status">@status</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (Model.Count == 0)
{
    <div class="empty-state"><h2 class="h5">No transactions yet</h2><p>Start a counter basket when a customer is ready to purchase a service.</p><a class="btn btn-primary" asp-action="Create">Create first transaction</a></div>
}
else
{
    <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Counter reference</th><th>Branch</th><th>Lines</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var transaction in Model)
    {
        <tr><td class="fw-semibold">@transaction.CounterReference</td><td>@transaction.BranchId</td><td>@transaction.Lines.Count</td><td>@transaction.Total.ToString("N2") @transaction.CurrencyCode</td><td><span class="badge text-bg-secondary">@transaction.Status</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@transaction.Id">Open</a></td></tr>
    }
    </tbody></table></div></div>
}
