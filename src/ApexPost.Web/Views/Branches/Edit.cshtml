@model ApexPost.Web.Models.BranchForm
@{ ViewData["Title"] = "Edit branch"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Edit @Model.Name</h1></div></div>
<div class="card form-card"><div class="card-body"><form asp-action="Edit" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><div class="row g-3">
    <div class="col-md-4"><label asp-for="Code" class="form-label">Branch code</label><input asp-for="Code" class="form-control" readonly/></div><div class="col-md-8"><label asp-for="Name" class="form-label">Branch name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="AddressLine1" class="form-label">Address</label><input asp-for="AddressLine1" class="form-control"/><span asp-validation-for="AddressLine1" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AddressLine2" class="form-label">Address line 2</label><input asp-for="AddressLine2" class="form-control"/></div><div class="col-md-4"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control"/><span asp-validation-for="City" class="text-danger"></span></div><div class="col-md-3"><label asp-for="PostalCode" class="form-label">Postal code</label><input asp-for="PostalCode" class="form-control"/><span asp-validation-for="PostalCode" class="text-danger"></span></div><div class="col-md-2"><label asp-for="CountryCode" class="form-label">Country</label><input asp-for="CountryCode" class="form-control" maxlength="2"/><span asp-validation-for="CountryCode" class="text-danger"></span></div><div class="col-md-3"><label asp-for="CounterCount" class="form-label">Counter count</label><input asp-for="CounterCount" class="form-control" type="number" min="1"/><span asp-validation-for="CounterCount" class="text-danger"></span></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save changes</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></div></div>
