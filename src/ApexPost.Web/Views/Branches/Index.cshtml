@model IReadOnlyList<ApexPost.Application.Branches.BranchResponse>
@{ ViewData["Title"] = "Branches"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Branches</h1><p class="text-secondary">Manage branch details, counters, and operational status.</p></div><a class="btn btn-primary" asp-action="Create">Add branch</a></div>
@if (Model.Count == 0) { <div class="empty-state"><h2 class="h5">No branches configured</h2><p>Create a branch before assigning staff or inventory.</p><a class="btn btn-primary" asp-action="Create">Add branch</a></div> }
else { <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Branch</th><th>City</th><th>Counters</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td class="fw-semibold">@item.Code</td><td>@item.Name</td><td>@item.City</td><td>@item.CounterCount</td><td><span class="badge @(item.Status == ApexPost.Domain.Branches.BranchStatus.Active ? "text-bg-success" : "text-bg-secondary")">@item.Status</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> @if (item.Status == ApexPost.Domain.Branches.BranchStatus.Active) { <form asp-action="Deactivate" method="post" class="d-inline" data-confirm="Close this branch? New operational writes will be blocked."><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><button class="btn btn-sm btn-outline-danger">Close</button></form> }</td></tr> }</tbody></table></div></div> }
