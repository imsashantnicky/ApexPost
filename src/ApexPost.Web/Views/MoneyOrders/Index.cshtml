@model IReadOnlyList<ApexPost.Application.MoneyOrders.MoneyOrderResponse>
@{ ViewData["Title"] = "Money orders"; }
<div class="page-heading"><div><p class="eyebrow">Counter</p><h1>Money orders</h1><p class="text-secondary">Money orders issued at your permitted branch scope. High-value orders require a successful identity verification first.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Verify">Verify identity</a><a class="btn btn-primary" asp-action="Create">Issue money order</a></div></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2 class="h5">No money orders yet</h2><p>Money orders for your permitted branch scope will appear here.</p><a class="btn btn-primary" asp-action="Create">Issue first money order</a></div>
}
else
{
    <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Order number</th><th>Beneficiary</th><th>Amount</th><th>Status</th><th>Verified</th><th></th></tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr><td class="fw-semibold">@item.OrderNumber</td><td>@item.BeneficiaryName</td><td>@item.Amount.ToString("N2") @item.CurrencyCode</td><td><span class="badge text-bg-secondary">@item.Status</span></td><td>@(item.IdentityVerificationId is null ? "Not required" : "Yes")</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a></td></tr>
    }
    </tbody></table></div></div>
}
