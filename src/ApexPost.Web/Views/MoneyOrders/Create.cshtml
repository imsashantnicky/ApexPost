@model ApexPost.Web.Models.MoneyOrderForm
@{ ViewData["Title"] = "Money orders and verification"; var requiresVerification = Model.Amount > Model.VerificationThreshold; }
<div class="page-heading"><div><p class="eyebrow">Counter services</p><h1>Money orders &amp; identity verification</h1><p class="text-secondary">High-value orders require a successful, branch-matched verification record before issue.</p></div></div>
<div class="row g-4">
    <div class="col-lg-8"><div class="card form-card"><div class="card-body"><h2 class="h5">Issue money order</h2><form asp-action="Issue" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input asp-for="IdentityVerificationId" type="hidden"/><input asp-for="VerificationThreshold" type="hidden"/>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="BranchId" class="form-label">Branch</label>
            @if (User.IsInRole(Roles.Administrator)) { <select asp-for="BranchId" class="form-select"><option value="">Choose branch</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select> }
            else { <input asp-for="BranchId" type="hidden"/><input class="form-control" value="@(Model.Branches.FirstOrDefault()?.Name ?? "Unavailable")" readonly/> }
            <span asp-validation-for="BranchId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="OrderNumber" class="form-label">Money order number</label><input asp-for="OrderNumber" class="form-control"/><span asp-validation-for="OrderNumber" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Amount" class="form-label">Amount</label><input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01"/><span asp-validation-for="Amount" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="CurrencyCode" class="form-label">Currency code</label><input asp-for="CurrencyCode" class="form-control"/><span asp-validation-for="CurrencyCode" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="BeneficiaryName" class="form-label">Beneficiary name</label><input asp-for="BeneficiaryName" class="form-control" autocomplete="off"/><span asp-validation-for="BeneficiaryName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="BeneficiaryReference" class="form-label">Beneficiary reference</label><input asp-for="BeneficiaryReference" class="form-control" autocomplete="off"/><span asp-validation-for="BeneficiaryReference" class="text-danger"></span></div>
        </div>
        <div class="alert alert-info mt-3">Verification threshold: @Model.VerificationThreshold.ToString("N2") @Model.CurrencyCode. Do not enter or store identity-document numbers in this form.</div>
        @if (Model.IdentityVerificationId is Guid verificationId) { <p class="text-success">Verified workflow record is attached: @verificationId.ToString("N").Substring(0, 8)</p> }
        <button class="btn btn-primary" type="submit">Issue money order</button>
    </form></div></div></div>
    <div class="col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Identity verification</h2><p>Start a verification record, complete the selected review, then return here to issue a high-value order.</p><a class="btn btn-outline-primary" asp-action="Verify" asp-route-branchId="@Model.BranchId">Start verification</a><hr/><p class="small text-secondary mb-0">Only the verification method and result are retained. The UI does not request a full document number.</p></div></div></div>
</div>
