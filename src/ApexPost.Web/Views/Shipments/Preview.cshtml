@model ApexPost.Web.Models.ShipmentPreviewForm
@{ ViewData["Title"] = "Shipping label preview"; }
<div class="page-heading"><div><p class="eyebrow">Shipping</p><h1>Label preview</h1><p class="text-secondary">This preview is not saved. Confirm booking to apply server-side branch, service, price, and weight rules.</p></div></div>
<div class="card label-preview"><div class="card-body">
    <div class="d-flex justify-content-between border-bottom pb-3 mb-3"><div><p class="eyebrow mb-1">ApexPost</p><h2 class="h4 mb-0">Shipment label</h2></div><div class="text-end"><span class="text-secondary">Reference</span><div class="fs-5 fw-bold">@Model.Number</div></div></div>
    <div class="row g-4"><section class="col-md-6"><h3 class="h6 text-uppercase text-secondary">From</h3><address><strong>@Model.SenderName</strong><br/>@Model.SenderLine1<br/>@Model.SenderCity @Model.SenderPostalCode<br/>@Model.SenderCountryCode</address></section><section class="col-md-6"><h3 class="h6 text-uppercase text-secondary">To</h3><address><strong>@Model.RecipientName</strong><br/>@Model.RecipientLine1<br/>@Model.RecipientCity @Model.RecipientPostalCode<br/>@Model.RecipientCountryCode</address></section></div>
    <div class="row border-top pt-3"><div class="col-sm-3"><span class="text-secondary">Service</span><div class="fw-semibold">@Model.ServiceName</div></div><div class="col-sm-3"><span class="text-secondary">Zone</span><div class="fw-semibold">@Model.ZoneCode</div></div><div class="col-sm-3"><span class="text-secondary">Level / weight</span><div class="fw-semibold">@Model.ServiceLevel · @Model.WeightKilograms.ToString("N3") kg</div></div><div class="col-sm-3"><span class="text-secondary">Charge</span><div class="fw-semibold">@Model.ChargeAmount.ToString("N2") @Model.CurrencyCode</div></div></div>
</div></div>
<form asp-action="Book" method="post" class="mt-4 d-flex gap-2">
    <input asp-for="BranchId" type="hidden"/><input asp-for="Number" type="hidden"/><input asp-for="ServiceId" type="hidden"/><input asp-for="ZoneCode" type="hidden"/><input asp-for="ServiceLevel" type="hidden"/><input asp-for="SenderName" type="hidden"/><input asp-for="SenderLine1" type="hidden"/><input asp-for="SenderCity" type="hidden"/><input asp-for="SenderPostalCode" type="hidden"/><input asp-for="SenderCountryCode" type="hidden"/><input asp-for="RecipientName" type="hidden"/><input asp-for="RecipientLine1" type="hidden"/><input asp-for="RecipientCity" type="hidden"/><input asp-for="RecipientPostalCode" type="hidden"/><input asp-for="RecipientCountryCode" type="hidden"/><input asp-for="WeightKilograms" type="hidden"/><input asp-for="Contents" type="hidden"/><input asp-for="CurrencyCode" type="hidden"/>
    <button type="submit" class="btn btn-primary">Confirm and book shipment</button><a asp-action="Book" class="btn btn-outline-secondary">Edit details</a>
</form>
