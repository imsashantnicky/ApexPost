@model ApexPost.Web.Models.ShipmentForm
@{ ViewData["Title"] = "Book shipment"; }
<div class="page-heading"><div><p class="eyebrow">Shipping</p><h1>Book shipment</h1><p class="text-secondary">Choose an active service. The server applies the current catalogue price and enforces the configured weight limit.</p></div><a class="btn btn-outline-secondary" asp-action="Index">All shipments</a></div>
<div class="card form-card"><div class="card-body"><form asp-action="Preview" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="form-section"><h2 class="h5">Shipment details</h2><div class="row g-3">
        <div class="col-md-6"><label asp-for="BranchId" class="form-label">Branch</label>
        @if (User.IsInRole(Roles.Administrator)) { <select asp-for="BranchId" class="form-select"><option value="">Select active branch</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select> }
        else { <input asp-for="BranchId" type="hidden"/><input class="form-control" value="@(Model.Branches.FirstOrDefault()?.Name ?? "Unavailable")" readonly/> }
        <span asp-validation-for="BranchId" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Number" class="form-label">Shipment reference</label><input asp-for="Number" class="form-control"/><span asp-validation-for="Number" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="ServiceId" class="form-label">Catalogue service</label><select asp-for="ServiceId" class="form-select"><option value="">Choose available service</option>@foreach (var service in Model.Services) { <option value="@service.Id">@service.Name (@service.Code)</option> }</select><span asp-validation-for="ServiceId" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="ZoneCode" class="form-label">Shipping zone</label><select asp-for="ZoneCode" class="form-select">@foreach (var zone in Model.ZoneCodes) { <option value="@zone">@zone</option> }</select><span asp-validation-for="ZoneCode" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="ServiceLevel" class="form-label">Service level</label><select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Shipping.ShippingServiceLevel>()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="CurrencyCode" class="form-label">Currency</label><input asp-for="CurrencyCode" class="form-control"/><span asp-validation-for="CurrencyCode" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="WeightKilograms" class="form-label">Weight (kg)</label><input asp-for="WeightKilograms" class="form-control" type="number" min="0.001" step="0.001"/><span asp-validation-for="WeightKilograms" class="text-danger"></span></div>
        <div class="col-md-8"><label asp-for="Contents" class="form-label">Contents description</label><input asp-for="Contents" class="form-control" maxlength="120"/><span asp-validation-for="Contents" class="text-danger"></span></div>
    </div></div>
    <div class="form-section"><h2 class="h5">Sender</h2><div class="row g-3">
        <div class="col-md-6"><label asp-for="SenderName" class="form-label">Name</label><input asp-for="SenderName" class="form-control"/><span asp-validation-for="SenderName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="SenderLine1" class="form-label">Address</label><input asp-for="SenderLine1" class="form-control"/><span asp-validation-for="SenderLine1" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="SenderCity" class="form-label">City</label><input asp-for="SenderCity" class="form-control"/><span asp-validation-for="SenderCity" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="SenderPostalCode" class="form-label">Postal code</label><input asp-for="SenderPostalCode" class="form-control"/><span asp-validation-for="SenderPostalCode" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="SenderCountryCode" class="form-label">Country code</label><input asp-for="SenderCountryCode" class="form-control" maxlength="2"/><span asp-validation-for="SenderCountryCode" class="text-danger"></span></div>
    </div></div>
    <div class="form-section"><h2 class="h5">Recipient</h2><div class="row g-3">
        <div class="col-md-6"><label asp-for="RecipientName" class="form-label">Name</label><input asp-for="RecipientName" class="form-control"/><span asp-validation-for="RecipientName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="RecipientLine1" class="form-label">Address</label><input asp-for="RecipientLine1" class="form-control"/><span asp-validation-for="RecipientLine1" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="RecipientCity" class="form-label">City</label><input asp-for="RecipientCity" class="form-control"/><span asp-validation-for="RecipientCity" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="RecipientPostalCode" class="form-label">Postal code</label><input asp-for="RecipientPostalCode" class="form-control"/><span asp-validation-for="RecipientPostalCode" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="RecipientCountryCode" class="form-label">Country code</label><input asp-for="RecipientCountryCode" class="form-control" maxlength="2"/><span asp-validation-for="RecipientCountryCode" class="text-danger"></span></div>
    </div></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Preview shipping label</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div></div>
