@model IReadOnlyList<ApexPost.Application.Shipping.ShipmentResponse>
@{ ViewData["Title"] = "Shipments"; }
<h1>Shipments</h1><p><a class="btn btn-primary" asp-action="Book">Book shipment</a></p>@if (TempData["Error"] is string error) { <p class="text-danger" role="alert">@error</p> }@if (!Model.Any()) { <p>No shipments are available.</p> } else { <table class="table"><thead><tr><th>Number</th><th>Status</th><th>Charge</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.ShipmentNumber</td><td>@item.Status</td><td>@item.ChargeAmount @item.CurrencyCode</td><td><form asp-action="Advance" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><button name="action" value="accept">Accept</button><button name="action" value="dispatch">Dispatch</button><button name="action" value="deliver">Deliver</button><button name="action" value="cancel">Cancel</button></form></td></tr>}</tbody></table>}
