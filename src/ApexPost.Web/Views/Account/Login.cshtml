@model ApexPost.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><label asp-for="UserName"></label><input asp-for="UserName" class="form-control"/><label asp-for="Password"></label><input asp-for="Password" class="form-control"/><button class="btn btn-primary mt-3">Sign in</button></form>
