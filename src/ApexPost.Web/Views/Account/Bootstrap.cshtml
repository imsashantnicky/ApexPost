@model ApexPost.Web.Models.BootstrapViewModel
@{ ViewData["Title"] = "Create administrator"; }
<h1>Create the first administrator</h1><p>This page is available only while no account exists. Link the account to an active staff record.</p><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><label asp-for="StaffId">Active staff member</label><select asp-for="StaffId" class="form-select"><option value="">Select staff</option>@foreach (var staff in Model.Staff) { <option value="@staff.Id">@staff.EmployeeNumber — @staff.Name (@staff.BranchName)</option> }</select><label asp-for="UserName"></label><input asp-for="UserName" class="form-control"/><label asp-for="Password"></label><input asp-for="Password" class="form-control"/><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control"/><button class="btn btn-primary mt-3">Create administrator</button></form>
