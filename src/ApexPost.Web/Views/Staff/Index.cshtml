@model IReadOnlyList<ApexPost.Web.Models.StaffIndexRow>
@{ ViewData["Title"] = "Staff"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Staff</h1><p class="text-secondary">Manage branch assignments and operational roles.</p></div><a class="btn btn-primary" asp-action="Create">Add staff member</a></div>
@if (Model.Count == 0) { <div class="empty-state"><h2 class="h5">No staff records</h2><p>Create a staff profile before provisioning a sign-in account.</p><a class="btn btn-primary" asp-action="Create">Add staff member</a></div> }
else { <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Employee number</th><th>Name</th><th>Branch</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var row in Model) { <tr><td class="fw-semibold">@row.Staff.EmployeeNumber</td><td>@row.Staff.Name</td><td>@row.BranchName</td><td>@string.Join(", ", row.Staff.Roles)</td><td><span class="badge @(row.Staff.Status == ApexPost.Domain.Staff.EmploymentStatus.Active ? "text-bg-success" : "text-bg-secondary")">@row.Staff.Status</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@row.Staff.Id">Edit</a> @if (row.Staff.Status == ApexPost.Domain.Staff.EmploymentStatus.Active) { <form asp-action="Deactivate" method="post" class="d-inline" data-confirm="Deactivate this staff member? Existing sessions will lose operational access on the next request."><input type="hidden" name="id" value="@row.Staff.Id"/><input type="hidden" name="version" value="@row.Staff.Version"/><button class="btn btn-sm btn-outline-danger">Deactivate</button></form> }</td></tr> }</tbody></table></div></div> }
