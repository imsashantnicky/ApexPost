@model ApexPost.Web.Models.StaffForm
@{ ViewData["Title"] = "Edit staff member"; }
<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Edit staff member</h1></div></div>
<div class="card form-card"><div class="card-body"><form asp-action="Edit" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/>
    <div class="row g-3"><div class="col-md-6"><label asp-for="EmployeeNumber" class="form-label">Employee number</label><input asp-for="EmployeeNumber" class="form-control" readonly/></div><div class="col-md-6"><label asp-for="Name" class="form-label">Staff name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="BranchId" class="form-label">Assigned branch</label><select asp-for="BranchId" class="form-select"><option value="">Choose active branch</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select><span asp-validation-for="BranchId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Role" class="form-label">Operational role</label><select asp-for="Role" class="form-select"><option value="CounterClerk">Counter clerk</option><option value="BranchManager">Branch manager</option><option value="InventoryClerk">Inventory clerk</option></select><span asp-validation-for="Role" class="text-danger"></span></div></div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save changes</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form></div></div>
