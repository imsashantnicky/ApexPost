@model IReadOnlyList<ApexPost.Application.Inventory.InventoryItemResponse>
@{ ViewData["Title"] = "Inventory"; }
<h1>Inventory</h1><p><a class="btn btn-primary" asp-action="Create">Create inventory item</a></p>@if (TempData["Error"] is string error) { <p class="text-danger" role="alert">@error</p> }@if (!Model.Any()) { <p>No inventory items are available.</p> } else { <table class="table"><thead><tr><th>SKU</th><th>Name</th><th>On hand</th><th>Status</th><th>Operation</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Sku</td><td>@item.Name</td><td>@item.QuantityOnHand</td><td>@(item.NeedsReorder ? "Reorder needed" : "In stock")</td><td><form asp-action="Receive" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><input name="quantity" type="number" min="1" required/><input name="reason" placeholder="Reason" required/><button class="btn btn-sm btn-primary">Receive</button></form><form asp-action="Issue" method="post"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="version" value="@item.Version"/><input name="quantity" type="number" min="1" required/><input name="reason" placeholder="Reason" required/><button class="btn btn-sm btn-outline-danger">Issue</button></form></td></tr>}</tbody></table>}
