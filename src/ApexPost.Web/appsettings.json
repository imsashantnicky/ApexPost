{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApexPost": {
    "JsonData": {
      "DataDirectory": "App_Data"
    },
    "JsonSeed": {
      "Enabled": true
    },
    "MoneyOrders": {
      "IdentityVerificationThreshold": 500
    },
    "Shipping": {
      "MaximumWeightKilograms": 70
    },
    "Integration": {
      "StaffId": ""
    },
    "Maintenance": {
      "Enabled": false,
      "RetryAfterSeconds": 300
    },
    "Security": {
      "TrustedProxies": [],
      "IntegrationAllowedIPs": [],
      "ApprovedCorsOrigins": [],
      "LoginPermitLimit": 5,
      "LoginWindowSeconds": 60,
      "PartnerPermitLimit": 60,
      "PartnerWindowSeconds": 60,
      "HstsMaxAgeDays": 180
    }
  }
}
